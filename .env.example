# Copie para .env e preencha (o .env NUNCA é versionado).
# Sem estas variáveis o sistema usa os fallbacks locais automaticamente.

# Azure AI Speech (Speech to Text) — portal.azure.com → Speech service → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Language (Text Analytics: sentimento, frases-chave, Text Analytics for Health)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com
AZURE_LANGUAGE=pt-BR

# (Opcional) Webhook para entrega dos alertas P1/P2: Microsoft Teams Incoming Webhook,
# Azure Logic Apps (HTTP trigger) ou Slack
ALERT_WEBHOOK_URL=
